DATABASE_URL=sqlite:///./words.db

NEWS_API_URL=https://newsdata.io/api/1/news?apikey=your_newsdata_api_key_here&country=bd&language=bn&category=top

# Reddit API Credentials
# Get these from: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=BangladeshTrendingAnalyzer/1.0 (Educational Research Project)

# Separate API keys for different sources
GROQ_API_KEY_NEWSPAPER=your_groq_api_key_for_newspaper_here
GROQ_API_KEY_REDDIT=your_groq_api_key_for_reddit_here
GROQ_API_KEY_COMBINE=your_groq_api_key_for_combine_here

FRONTEND_URL=http://localhost:5173

# Mail (SMTP)
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_app_password_here
MAIL_FROM=noreply@example.com
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=IML Trending Analyzer
MAIL_PORT=587

# Legacy key for backward compatibility
GROQ_API_KEY=your_groq_api_key_here

FACEBOOK_GRAPH_API_KEY=your_facebook_graph_api_key_here
SECRET_KEY=your_secret_key_here

GOOGLE_TRENDS_API_KEY=
YOUTUBE_API_KEY=
TWITTER_API_KEY=
FACEBOOK_INSIGHTS_API_KEY=

SERPAPI_API_KEY=your_serpapi_api_key_here
TELEGRAM_APP_ID=your_telegram_app_id_here
TELEGRAM_APP_HASH=your_telegram_app_hash_here
